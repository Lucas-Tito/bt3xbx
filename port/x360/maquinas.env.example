# Máquinas e rede de quem desenvolve: modelo versionado. A cópia real NÃO vai ao git.
# Copie para ~/.config/bt3xbx/maquinas.env (vale para todas as worktrees) ou para port/x360/maquinas.env
# (ignorado pelo git) e preencha. Os scripts que falam com o WSL leem este arquivo; variável já definida no
# ambiente vence o arquivo. Anote aqui também o que só serve à sua rede (IPs que já mudaram, apelidos, pastas).

# PC Windows com o WSL (entrada do ~/.ssh/config com a chave; o IP vem por DHCP e pode mudar: achar pela porta 22)
BT3_WSL_HOST=meu-pc-wsl
BT3_WSL_USER=meuusuario
# BT3_WSL_IP=192.0.2.10            # só se o IP mudou e o ~/.ssh/config ainda aponta o antigo

# Console (FreeStyle, FTP na porta 21; IP por DHCP: achar pela porta 21)
BT3_CONSOLE_IP=192.0.2.20
# Prefixo da rede local para procurar o console e o PC (ex.: 192.0.2)
BT3_REDE=192.0.2

# Outras máquinas de teste (opcional)
# BT3_DECK_IP=192.0.2.30
