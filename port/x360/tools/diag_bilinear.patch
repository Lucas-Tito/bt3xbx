+/* (diagnóstico do bt3xbx, port/x360/tools/diag_bilinear.patch, só no WSL; F8, pendência 5) a referência do brilho do
+   caminho de GPU do PC: BT3_GS_BILINEAR=1 lê com o filtro bilinear do GS (o texel em u - 0,5, pesos de 1/16) os
+   sprites em UV com TEX1.MMAG ligado (a cadeia do brilho e os outros efeitos de alvo em alvo; o 3D segue no ponto);
+   BT3_GS_ALFA_PC=1 prende em 0x80 o alfa que a mistura usa como fator (o PC guarda e mistura min(A / 0x80, 1));
+   BT3_GLOW=N põe a cor do desenho que soma um alvo ao quadro (ALPHA 0x68) a N%, como o gs_draw.c. Sem as chaves, nada
+   muda. */
+static int sDiagBil = -1, sDiagGlow = 100;
+static void diag_le(void) {
+    if (sDiagBil < 0) {
+        sDiagBil = getenv("BT3_GS_BILINEAR") != NULL && atoi(getenv("BT3_GS_BILINEAR")) != 0;
+        sDiagAlfaPc = getenv("BT3_GS_ALFA_PC") != NULL && atoi(getenv("BT3_GS_ALFA_PC")) != 0;
+        sDiagGlow = getenv("BT3_GLOW") != NULL ? atoi(getenv("BT3_GLOW")) : 100;
+        if (sDiagBil || sDiagAlfaPc || sDiagGlow != 100) {
+            fprintf(stderr, "gs_core: diagnóstico do brilho: bilinear %d, alfa do PC %d, brilho %d%%\n", sDiagBil, sDiagAlfaPc, sDiagGlow);
+        }
+    }
+}
+static uint32_t texel_bil(int ctx, int u, int v) {
+    int tu = u - 8, tv = v - 8, iu = tu >> 4, iv = tv >> 4, fu = tu & 15, fv = tv & 15, k;
+    uint32_t c00 = texel(ctx, iu, iv), c10 = texel(ctx, iu + 1, iv), c01 = texel(ctx, iu, iv + 1), c11 = texel(ctx, iu + 1, iv + 1), out = 0;
+    for (k = 0; k < 32; k += 8) {
+        uint32_t a = (c00 >> k) & 0xFF, b = (c10 >> k) & 0xFF, c = (c01 >> k) & 0xFF, d = (c11 >> k) & 0xFF;
+        uint32_t m = ((a * (16 - fu) + b * fu) * (16 - fv) + (c * (16 - fu) + d * fu) * fv + 128) >> 8;
+        out |= (m > 255 ? 255 : m) << k;
+    }
+    return out;
+}
